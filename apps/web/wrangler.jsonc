// Configuração do Worker (deploy via @opennextjs/cloudflare).
// Antes do 1º deploy, crie os recursos e preencha os IDs (ver README, seção Deploy):
//   wrangler kv namespace create netfor-inc-cache
//   wrangler d1 create netfor-tag-cache
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netfor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "netfor",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0827928af23444fabd166d165338459d",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "netfor-tag-cache",
      "database_id": "d43fb0af-3484-4e82-9e58-1d9ccce5f1de",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // Domínio próprio: netfor.com.br (zona ativa na Cloudflare desde 31/07/2026).
  // custom_domain cria o registro DNS e o certificado automaticamente.
  "routes": [
    { "pattern": "netfor.com.br", "custom_domain": true },
    { "pattern": "www.netfor.com.br", "custom_domain": true },
  ],
  "vars": {
    "REWRITE_MODE": "false",
  },
  // Secrets em runtime (definir com `wrangler secret put`):
  //   DATABASE_URL, REVALIDATE_SECRET
}

// Configuração do Worker (deploy via @opennextjs/cloudflare).
// Antes do 1º deploy, crie os recursos e preencha os IDs (ver README, seção Deploy):
//   wrangler kv namespace create netfor-inc-cache
//   wrangler d1 create netfor-tag-cache
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netfor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "netfor"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "PREENCHER_ID_DO_KV"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "netfor-tag-cache",
      "database_id": "PREENCHER_ID_DO_D1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "vars": {
    "REWRITE_MODE": "false"
  }
  // Secrets em runtime (definir com `wrangler secret put`):
  //   DATABASE_URL, REVALIDATE_SECRET
}

// Vigia do "próximo jogo". Worker separado do site de propósito: um erro aqui
// não pode derrubar o portal, e o deploy de um não arrasta o do outro.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "netfor-revalidacao",
  "main": "src/index.ts",
  // Data mais recente que o workerd empacotado no wrangler 4.115 aceita. Subir
  // além disso quebra o `wrangler dev` com "newest date supported is ...".
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // A cada 15 min. É só uma leitura de KV por execução — o banco e a
    // revalidação só entram quando um jogo de fato acabou. O intervalo define a
    // precisão: o banner troca em até 15 min depois do fim da partida.
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "ESTADO",
      "id": "2fa767b2e87f4b9c9dcd7f26abe14756"
    }
  ],
  "vars": {
    "SITE_URL": "https://netfor.com.br",
    // Alvo do despertador: o vigia dispara este workflow ~80 min antes do apito
    // porque o cron do GitHub, estrangulado em repositório público, não garante
    // execução na janela em que a escalação é publicada. Não são segredos —
    // repositório público e nome de arquivo.
    "GITHUB_REPO": "jeffersonbraster/netforof",
    "GITHUB_WORKFLOW": "matches.yml"
  },
  // Sem isto o worker não grava log e a única pista de falha seria o banner
  // parado. Foi a lição do Error 1101.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // Secrets em runtime (definir com `wrangler secret put`):
  //   DATABASE_URL, REVALIDATE_SECRET, GITHUB_DISPATCH_TOKEN
  // Os do Telegram e o do dispatch são sincronizados pelo deploy.yml a partir
  // dos secrets do GitHub, que é a fonte da verdade — não recriar à mão aqui.
}
